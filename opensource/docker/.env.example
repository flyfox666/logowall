# Host port the wall is exposed on (change if 8080 is taken), e.g. PORT=8081
PORT=8080

# Password for the "admin" account created on first start. Leave empty to get
# a random one printed in the logs:  docker compose logs logo-wall | grep password
ADMIN_PASSWORD=

# Optional legacy master token for API scripts; disabled when empty.
# Must be >= 12 characters (e.g. `openssl rand -hex 24`).
ADMIN_TOKEN=

# Optional: extra origins allowed to call the API cross-origin (comma-separated)
#CORS_ORIGINS=

# Behind a reverse proxy (Caddy / Nginx / Cloudflare Tunnel container), set its
# IP (or a comma-separated list) so login throttling sees real client IPs.
#FORWARDED_ALLOW_IPS=172.18.0.1

# Optional: LOG_LEVEL=info | warning | error | debug
#LOG_LEVEL=info
