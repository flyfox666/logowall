# Logo Wall local config - copy to config.env and edit, then restart.

# Service port: change if 8080 is taken, e.g. 8081 / 9000
PORT=8080
# Bind address: 0.0.0.0 = LAN accessible; 127.0.0.1 = this machine only
HOST=0.0.0.0

# Password for the "admin" account created on FIRST start only.
# Leave empty to get a random password printed in the console.
#ADMIN_PASSWORD=

# Optional legacy master token for scripts calling the API
# (Authorization: Bearer <token>). Disabled when empty; weak values such as
# admin123 or anything shorter than 12 characters are refused.
#ADMIN_TOKEN=

# Login session signing secret. Empty = random, stored in DATA_DIR/.jwt_secret
#JWT_SECRET=
# Login session lifetime (days)
#JWT_EXPIRE_DAYS=7

# Data directory: empty = this folder (data.json / logos/); point elsewhere to centralize backups
#DATA_DIR=/path/to/data

# Max logo upload size (MB); raster logos larger than LOGO_MAX_PX are downscaled (0 = off)
MAX_UPLOAD_MB=5
#LOGO_MAX_PX=800
# Poster image proxy: per-image limit (MB) and timeout (seconds)
IMGPROXY_MAX_MB=8
IMGPROXY_TIMEOUT=10
# Allow the image proxy / logo download to reach intranet addresses (SSRF risk!)
#FETCH_ALLOW_PRIVATE=false
# Extra origins allowed to call the API from other sites (comma-separated)
#CORS_ORIGINS=
# Log level: info / warning / error / debug
LOG_LEVEL=info
