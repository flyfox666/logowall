# Logo Wall local config - copy to config.env and edit, then restart.

# Service port: change if 8080 is taken, e.g. 8081 / 9000
PORT=8080
# Bind address: 0.0.0.0 = LAN accessible; 127.0.0.1 = this machine only
HOST=0.0.0.0
# Admin token for write operations
ADMIN_TOKEN=admin123
# Data directory: empty = this folder (data.json / logos/); point elsewhere to centralize backups
#DATA_DIR=/path/to/data
# Max logo upload size (MB)
MAX_UPLOAD_MB=5
# Poster image proxy: per-image limit (MB) and timeout (seconds)
IMGPROXY_MAX_MB=8
IMGPROXY_TIMEOUT=10
# Log level: info / warning / error / debug
LOG_LEVEL=info
